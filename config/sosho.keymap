//スクロール量の調整(デフォルト150)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

/ {
	behaviors {
        ec_ms_l: ec_ms_h {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
        ec_ms_r: ec_ms_v {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };
};

/ {
    macros {
        alt_x2: alt_x2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LALT &kp LALT>;
        };
    };
};

//スクロールの調整
&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};

/{
    combos {
        compatible = "zmk,combos";
		//左クリックのコンボ 19はJのキー 20はKのキーに相当します。
	    combo_LCLK {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mkp LCLK>;
        };

		//右クリックのコンボ 20 K 21 L
        combo_RCLK {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp RCLK>;
        };

		//ホイールクリックのコンボ 19 J 21 L
	    combo_MCLK {
            timeout-ms = <90>;
            key-positions = <19 21>;
            bindings = <&mkp MCLK>;
        };

    };
};

/{
keymap {
    compatible = "zmk,keymap";

    default_layer {
        bindings = <
            &lt 1 ESC  &kp Q   &kp W  &kp E     &kp R     &kp T      &kp Y      &kp U      &kp I      &kp O    &kp P     &mt LCTRL LBKT
            &lt 2 TAB  &kp A   &kp S  &kp D     &kp F     &kp G      &kp H      &kp J      &kp K      &kp L    &kp SEMI  &mt LALT RBKT
            &kp LSHFT  &kp Z   &kp X  &kp C     &kp V     &kp B      &kp N      &kp M      &kp COMMA  &kp DOT  &kp SLASH &mt LGUI SQT
            &kp LG(LA(LC(C)))  &alt_x2    &mo 3     &kp BSPC      &kp ENTER  &kp SPACE                      &kp GRAVE &kp BSLH
        >;
		//&ec_ms_lとrは、上のビヘイビアで作ったもの。
        sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
    };
	
    layer_1 {
        bindings = <
            &none  &none  &kp AMPS  &kp ASTRK  &kp LPAR   &kp RPAR      &none    &kp N7  &kp N8  &kp N9  &none      &kp BSPC
            &none  &none  &kp DLLR  &kp PRCNT  &kp CARET  &none         &none    &kp N4  &kp N5  &kp N6  &kp PLUS   &kp ASTRK
            &none  &none  &kp EXCL  &kp AT     &kp HASH   &none         &none    &kp N1  &kp N2  &kp N3  &kp MINUS  &kp SLASH
            &none  &none                       &none      &kp ENTER     &kp DOT  &kp N0                  &none      &none
        >;
    };

    layer_2 {
        bindings = <
            &none  &none  &none         &none       &none          &none      &none   &kp LC(LA(E))  &kp LC(LA(R))  &kp LC(LA(T))  &none      &none
            &none  &none  &kp LC(LEFT)  &kp LC(UP)  &kp LC(RIGHT)  &none      &none   &kp LEFT       &kp UP         &kp DOWN       &kp RIGHT  &none
            &none  &none  &none         &none       &none          &none      &none   &kp LC(LA(D))  &kp LC(LA(F))  &kp LC(LA(G))  &none      &none
            &none  &none                            &kp LG(C)      &kp LG(V)  &kp LG(R)  &none                                        &none      &none
        >;
		//レイヤー2のときだけ、左手のエンコーダを回すとボリュームの上下ができるようになっています。
		sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &ec_ms_r SCRL_DOWN SCRL_UP>;

    };

    layer_3 {
        bindings = <
            &none &none        &none &none &none &none      &none  &bt BT_SEL 0  &bt BT_SEL 1  &none  &none  &none
            &none &bt BT_NXT   &none &none &none &none      &none  &none         &none         &none  &none  &none
            &none &none        &none &none &none &none      &none  &none         &none         &none  &none  &none
            &none &none             &none &none      &none  &none                &none  &none
        >;
    };
    scroll {
        status = "reserved";
    };

    extra2 {
        status = "reserved";
    };
};
};
