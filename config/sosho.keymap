//スクロール量の調整(デフォルト150)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

/ {
	behaviors {
        ec_ms_l: ec_ms_h {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
        ec_ms_r: ec_ms_v {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };
};

/ {
    behaviors {
        mtq: mtq {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        mt_spc: mt_spc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        lt_mkp: lt_mkp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&mkp>;
        };
    };
};

//スクロールの調整
&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};

&mt {
    require-prior-idle-ms = <150>;
};

/{
keymap {
    compatible = "zmk,keymap";

    default_layer {
        bindings = <
            &lt 1 ESC  &kp Q   &kp L  &kp U     &kp COMMA &kp DOT    &kp F      &kp W      &kp R      &kp Y    &kp P     &kp BSPC
            &lt 2 TAB  &kp E   &kp I  &kp A     &kp O     &kp MINUS  &kp K      &kp T      &kp N      &kp S    &kp H     &kp EQUAL
            &kp LSHFT  &kp Z   &kp X  &kp C     &kp V     &kp SEMI   &kp G      &kp D      &kp M      &kp J    &kp B     &mt LCTRL SLASH
            &kp LALT           &kp LCTRL  &mkp LCLK       &lt_mkp 4 RCLK      &mtq LGUI ENTER  &mt_spc LALT SPACE  &mtq RSHFT GRAVE  &lt 3 BSLH
        >;
		//&ec_ms_lとrは、上のビヘイビアで作ったもの。
        sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
    };
	
    layer_1 {
        bindings = <
            &kp ESC  &none  &kp F2    &kp TAB            &kp LG(Z)      &kp BSPC       &kp LBKT &kp N7  &kp N8  &kp N9  &kp DEL    &kp BSPC
            &none  &none  &kp LEFT    &kp UP             &kp DOWN       &kp RIGHT      &kp RBKT &kp N4  &kp N5  &kp N6  &kp PLUS   &kp ASTRK
            &none  &none  &kp LG(N1)  &kp LC(LS(EQUAL))  &kp LG(MINUS)  &kp LG(LS(F))  &kp SQT  &kp N1  &kp N2  &kp N3  &kp MINUS  &kp SLASH
            &none  &none                                 &kp LSHFT      &mtq LGUI ENTER  &kp DOT  &kp N0                &kp TILDE  &tog 1
        >;
    };

    layer_2 {
        bindings = <
            &none  &none  &kp LG(LEFT)  &kp LG(UP)  &kp LG(DOWN)  &kp LG(RIGHT)     &kp AMPS  &kp ASTRK  &kp LPAR   &kp RPAR   &kp LC(LA(D))  &kp LC(LA(E))
            &none  &none  &kp LEFT      &kp UP      &kp DOWN      &kp RIGHT         &kp DLLR  &kp PRCNT  &kp CARET  &kp UNDER  &kp LC(LA(F))  &kp LC(LA(R))
            &none  &none  &kp LBRC      &kp RBRC    &kp DQT       &kp COLON         &kp EXCL  &kp AT     &kp HASH   &kp PIPE   &kp LC(LA(G))  &kp LC(LA(T))
            &none  &none                &kp LSHFT   &kp LALT      &kp LC(LEFT)      &kp LC(RIGHT)                              &kp LG(LS(N4))  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS
        >;
		//レイヤー2のときだけ、左手のエンコーダを回すとボリュームの上下ができるようになっています。
		sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &ec_ms_r SCRL_DOWN SCRL_UP>;

    };

    fn_layer {
        bindings = <
            &none  &bootloader  &kp F1  &kp F2   &kp F3   &kp F4   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_NXT  &none  &none
            &none  &none  &kp F5  &kp F6   &kp F7   &kp F8   &none         &none         &none         &bt BT_CLR  &none  &none
            &none  &sys_reset  &kp F9  &kp F10  &kp F11  &kp F12  &bootloader   &none         &none         &sys_reset  &none  &none
            &none  &none                   &none    &none    &none         &none                                   &none  &none
        >;
    };

    scroll {
        bindings = <
            &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans                  &trans  &trans      &trans  &trans                  &trans  &trans
        >;
    };

    extra2 {
        status = "reserved";
    };
};
};
