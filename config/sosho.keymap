//スクロール量の調整(デフォルト150)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

/ {
	behaviors {
        ec_ms_l: ec_ms_h {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
        ec_ms_r: ec_ms_v {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };
};

//スクロールの調整
&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};

/{
    combos {
        compatible = "zmk,combos";
		//左クリックのコンボ 19はJのキー 20はKのキーに相当します。
	    combo_LCLK {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mkp LCLK>;
        };

		//右クリックのコンボ 20 K 21 L
        combo_RCLK {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp RCLK>;
        };

		//ホイールクリックのコンボ 19 J 21 L
	    combo_MCLK {
            timeout-ms = <90>;
            key-positions = <19 21>;
            bindings = <&mkp MCLK>;
        };

    };
};

/{
keymap {
    compatible = "zmk,keymap";

    default_layer {
        bindings = <
            &mo 1      &kp Q   &kp W  &kp E     &kp R     &kp T      &kp Y      &kp U      &kp I      &kp O    &kp P     &kp LCTRL
            &mo 2      &kp A   &kp S  &kp D     &kp F     &kp G      &kp H      &kp J      &kp K      &kp L    &kp SQT   &mo 3
            &kp LSHFT  &kp Z   &kp X  &kp C     &kp V     &kp B      &kp N      &kp M      &kp COMMA  &kp DOT  &kp SLASH &kp GRAVE
            &kp LGUI   &kp LALT              &kp LGUI  &kp LALT      &kp ENTER  &kp SPACE                      &none     &kp BSLH
        >;
		//&ec_ms_lとrは、上のビヘイビアで作ったもの。
        sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
    };
	
    layer_1 {
        bindings = <
            &trans &trans &kp AMPS  &kp ASTRK  &kp LPAR   &kp RPAR      &trans   &kp N7  &kp N8  &kp N9  &trans     &kp BSPC
            &trans &trans &kp DLLR  &kp PRCNT  &kp CARET  &trans        &trans   &kp N4  &kp N5  &kp N6  &kp PLUS   &kp ASTRK
            &trans &trans &kp EXCL  &kp AT     &kp HASH   &trans        &trans   &kp N1  &kp N2  &kp N3  &kp MINUS  &kp SLASH
            &trans &trans                      &trans     &kp ENTER     &kp DOT  &kp N0                  &trans     &trans
        >;
    };

    layer_2 {
        bindings = <
            &trans &trans &trans        &trans      &trans         &trans     &trans  &kp LC(LA(E))  &kp LC(LA(R))  &kp LC(LA(T))  &trans     &trans
            &trans &trans &kp LC(LEFT)  &kp LC(UP)  &kp LC(RIGHT)  &trans     &trans  &kp LEFT       &kp UP         &kp DOWN       &kp RIGHT  &trans
            &trans &trans &trans        &trans      &trans         &trans     &trans  &kp LC(LA(D))  &kp LC(LA(F))  &kp LC(LA(G))  &trans     &trans
            &trans &trans                           &trans         &trans     &trans  &trans                                       &trans     &trans
        >;
		//レイヤー2のときだけ、左手のエンコーダを回すとボリュームの上下ができるようになっています。
		sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &ec_ms_r SCRL_DOWN SCRL_UP>;

    };

    layer_3 {
        bindings = <
            &none &none        &none &none &none &none      &none  &bt BT_SEL 0  &bt BT_SEL 1  &none  &none  &none
            &none &bt BT_NXT   &none &none &none &none      &none  &none         &none         &none  &none  &none
            &none &none        &none &none &none &none      &none  &none         &none         &none  &none  &none
            &none &none             &none &none      &none  &none                &none  &none
        >;
    };
    scroll {
        status = "reserved";
    };

    extra2 {
        status = "reserved";
    };
};
};
